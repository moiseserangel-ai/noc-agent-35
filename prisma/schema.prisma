generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(uuid())
  username           String   @unique
  name               String
  passwordHash       String
  role               String   @default("viewer") // admin|operator|viewer
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  username  String
  displayName String?
  role      String?
  action    String
  resource  String
  resourceId String?
  status    String   @default("success")
  ipAddress String?
  userAgent String?
  details   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([username, createdAt])
  @@index([resource, action])
}

model NotificationLog {
  id           String   @id @default(uuid())
  taskId       String?
  taskNumber   Int?
  event        String
  channel      String
  recipient    String?
  status       String
  error        String?
  dedupKey     String   @unique
  createdAt    DateTime @default(now())

  @@index([taskId, createdAt])
  @@index([status, channel])
}

model Device {
  id           String   @id @default(uuid())
  name         String
  hostname     String
  port         Int      @default(22)
  type         String   // "mikrotik" | "linux"
  username     String
  password     String   // Encrypted (AES-256-GCM)
  group        String?
  zabbixHostId String?
  isActive     Boolean  @default(true)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tasks        Task[]
}

model Task {
  id               String        @id @default(uuid())
  taskNumber       Int           @unique
  deviceId         String?
  device           Device?       @relation(fields: [deviceId], references: [id])
  source           String        // "whatsapp" | "zabbix" | "dashboard"
  workType         String        @default("incident") // incident|consultation|configuration
  status           String        @default("pending") // pending|diagnosing|awaiting_approval|executing|completed|failed|cancelled
  originalMessage  String
  diagnosis        String?
  proposedSolution String?
  adminResponse    String?       // "yes" | "no" | null
  executionResult  String?
  agentUsed        String?       // "support" | "mikrotik" | "linux"
  priority         String        @default("medium") // low|medium|high|critical
  zabbixEventId    String?       @unique
  zabbixRecoveryId String?
  zabbixStatus     String?
  incidentKey      String?
  incidentOpenedAt DateTime?
  lastSeenAt       DateTime?
  resolvedAt       DateTime?
  durationSeconds  Int?
  occurrenceCount  Int           @default(1)
  duplicateCount   Int           @default(0)
  assignedTo       String?
  acknowledgedAt   DateTime?
  dueAt             DateTime?
  resolutionSummary String?
  resolutionType   String?
  validatedAt      DateTime?
  closedAt         DateTime?
  slaAckDueAt      DateTime?
  slaResolveDueAt  DateTime?
  slaWarningSentAt DateTime?
  slaAckBreachedAt DateTime?
  slaResolveBreachedAt DateTime?
  escalationLevel Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  messages         TaskMessage[]

  @@index([incidentKey, status])
}

model TaskMessage {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  role      String   // "user" | "agent" | "system"
  content   String
  agentName String?
  createdAt DateTime @default(now())
}

model Settings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  encrypted Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model ChatSession {
  id        String        @id @default(uuid())
  title     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String      // "user" | "assistant"
  content   String
  agentUsed String?
  toolCalls String?     // JSON string with tools used
  createdAt DateTime    @default(now())
}
