model RunbookExecution {
  id            String    @id @default(uuid())
  runbookId     String
  runbook       Runbook   @relation(fields: [runbookId], references: [id], onDelete: Restrict)
  deviceId      String
  device        Device    @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  taskId        String?
  task          Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  scheduleId    String?
  schedule      RunbookSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  batchId       String?
  batch         RunbookBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  mode          String // simulation|execution|rollback
  status        String    @default("queued") // queued|running|completed|failed|blocked
  inputHash     String
  variables     String    @default("{}") // JSON
  renderedSteps String    @default("[]") // JSON
  results       String    @default("[]") // JSON
  requestedBy   String
  approvedBy    String?
  beforeBackupId String?
  beforeBackup   DeviceConfigBackup? @relation("RunbookBeforeBackup", fields: [beforeBackupId], references: [id], onDelete: SetNull)
  afterBackupId  String?
  afterBackup    DeviceConfigBackup? @relation("RunbookAfterBackup", fields: [afterBackupId], references: [id], onDelete: SetNull)
  configurationChanged Boolean?
  error         String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([runbookId, createdAt])
  @@index([deviceId, createdAt])
  @@index([taskId, createdAt])
  @@index([scheduleId, createdAt])
  @@index([batchId, createdAt])
  @@index([beforeBackupId])
  @@index([afterBackupId])
  @@index([inputHash, mode, status])
}

model RunbookBatch {
