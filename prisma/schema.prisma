generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String        @id @default(uuid())
  username            String        @unique
  name                String
  passwordHash        String
  role                String        @default("viewer") // admin|operator|viewer
  isActive            Boolean       @default(true)
  mustChangePassword  Boolean       @default(true)
  passwordChangedAt   DateTime?
  twoFactorSecret     String?
  twoFactorEnabled    Boolean       @default(false)
  failedLoginAttempts Int           @default(0)
  lockedUntil         DateTime?
  sessionVersion      Int           @default(1)
  lastLoginAt         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  tenantId            String?
  tenant              Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  sessions            AuthSession[]
  onCallMemberships   OnCallMember[]
  onCallShifts        OnCallShift[]
  onCallOverrides     OnCallOverride[]
}

model Tenant {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  document    String?
  contactName String?
  contactEmail String?
  contactPhone String?
  portalTitle String?
  portalDescription String?
  primaryColor String @default("#00d4ff")
  slaLowAck Int?
  slaLowResolve Int?
  slaMediumAck Int?
  slaMediumResolve Int?
  slaHighAck Int?
  slaHighResolve Int?
  slaCriticalAck Int?
  slaCriticalResolve Int?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  users       User[]
  sites       TenantSite[]
  devices     Device[]
  tasks       Task[]
  statusServices StatusService[]
  onCallTeams OnCallTeam[]
  notificationRules NotificationRule[]
  knowledgeDocuments KnowledgeDocument[]
  knowledgeImportJobs KnowledgeImportJob[]
  monthlyReportEnabled Boolean @default(false)
  monthlyReportDay Int @default(1)
  monthlyReportHour Int @default(8)
  monthlyReportTimezone String @default("America/Porto_Velho")
  monthlyReportChannels String @default("panel")
  monthlyReportRecipients String?
  monthlyReportTelegramRecipients String?
  monthlyReportWhatsappRecipients String?
  monthlyReportRuns MonthlyReportRun[]
  cmdbAssets CmdbAsset[]
  ipamSubnets IpamSubnet[]
  businessServices BusinessService[]
  suppliers Supplier[]
  commercialContracts CommercialContract[]
  softwareLicenses SoftwareLicense[]

  @@index([isActive, name])
}

model Supplier {
  id              String   @id @default(uuid())
  tenantId        String?
  tenant          Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  name            String
  legalName       String?
  document        String?
  status          String   @default("active")
  manufacturers   String?
  website         String?
  supportHours    String?
  technicalName   String?
  technicalEmail  String?
  technicalPhone  String?
  commercialName  String?
  commercialEmail String?
  commercialPhone String?
  escalationPhone String?
  rating          Int?
  notes           String?
  createdBy       String
  updatedBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  contracts       CommercialContract[]
  licenses        SoftwareLicense[]

  @@index([tenantId, status, name])
  @@index([status, name])
}

model CommercialContract {
  id                String   @id @default(uuid())
  number            String   @unique
  title             String
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  supplierId        String
  supplier          Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  status            String   @default("draft")
  startDate         DateTime
  endDate           DateTime
  amount            Float?
  currency          String   @default("BRL")
  billingCycle      String   @default("annual")
  renewalType       String   @default("manual")
  noticeDays        Int      @default(30)
  serviceHours      String?
  slaCriticalMinutes Int?
  slaHighMinutes    Int?
  owner             String?
  ownerEmail        String?
  documentUrl       String?
  notes             String?
  createdBy         String
  updatedBy         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  assets            CommercialContractAsset[]
  licenses          SoftwareLicense[]

  @@index([tenantId, status, endDate])
  @@index([supplierId, status])
}

model CommercialContractAsset {
  contractId String
  contract   CommercialContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  assetId    String
  asset      CmdbAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([contractId, assetId])
  @@index([assetId])
}

model SoftwareLicense {
  id              String   @id @default(uuid())
  name            String
  product         String
  vendor          String?
  edition         String?
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  supplierId      String?
  supplier        Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  contractId      String?
  contract        CommercialContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  licenseType     String   @default("subscription")
  status          String   @default("active")
  reference       String?
  keyLast4        String?
  seatsPurchased  Int      @default(1)
  seatsUsed       Int      @default(0)
  startDate       DateTime?
  expiresAt       DateTime?
  renewalType     String   @default("manual")
  noticeDays      Int      @default(30)
  amount          Float?
  currency        String   @default("BRL")
  billingCycle    String   @default("annual")
  owner           String?
  ownerEmail      String?
  portalUrl       String?
  notes           String?
  createdBy       String
  updatedBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  assets          SoftwareLicenseAsset[]

  @@index([tenantId, status, expiresAt])
  @@index([supplierId, status])
  @@index([contractId])
}

model SoftwareLicenseAsset {
  licenseId String
  license   SoftwareLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  assetId   String
  asset     CmdbAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([licenseId, assetId])
  @@index([assetId])
}

model TenantSite {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  city      String?
  state     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  devices   Device[]
  cmdbAssets CmdbAsset[]
  ipamSubnets IpamSubnet[]

  @@unique([tenantId, name])
}

model AuthSession {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress  String?
  userAgent  String?
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  username     String
  displayName  String?
  role         String?
  action       String
  resource     String
  resourceId   String?
  status       String   @default("success")
  ipAddress    String?
  userAgent    String?
  details      String?
  previousHash String?
  recordHash   String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([username, createdAt])
  @@index([resource, action])
}

model NotificationLog {
  id         String   @id @default(uuid())
  taskId     String?
  taskNumber Int?
  event      String
  channel    String
  recipient  String?
  status     String
  error      String?
  title      String?
  message    String?
  priority   String?
  resourceType String?
  resourceId String?
  readAt     DateTime?
  readBy     String?
  dedupKey   String   @unique
  createdAt  DateTime @default(now())

  @@index([taskId, createdAt])
  @@index([status, channel])
  @@index([channel, readAt, createdAt])
  @@index([resourceType, resourceId])
}

model NotificationRule {
  id          String   @id @default(uuid())
  name        String
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(100)
  priorities  String   @default("") // comma-separated
  events      String   @default("")
  sources     String   @default("")
  deviceGroups String  @default("")
  channels    String   @default("panel")
  recipients  String   @default("")
  activeDays  String   @default("0,1,2,3,4,5,6")
  startTime   String   @default("00:00")
  endTime     String   @default("23:59")
  timezone    String   @default("America/Porto_Velho")
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled, sortOrder])
}

model OnCallTeam {
  id          String           @id @default(uuid())
  name        String
  tenantId    String?
  tenant      Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  description String?
  timezone    String           @default("America/Porto_Velho")
  enabled     Boolean          @default(true)
  createdBy   String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  members     OnCallMember[]
  shifts      OnCallShift[]
  overrides   OnCallOverride[]

  @@index([enabled, name])
}

model OnCallMember {
  id             String     @id @default(uuid())
  teamId         String
  team           OnCallTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  telegramChatId String?
  whatsappNumber String?
  priority       Int        @default(100)
  enabled        Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([teamId, userId])
  @@index([teamId, enabled, priority])
}

model OnCallShift {
  id        String     @id @default(uuid())
  teamId    String
  team      OnCallTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startTime String
  endTime   String
  enabled   Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([teamId, dayOfWeek, enabled])
}

model OnCallOverride {
  id        String     @id @default(uuid())
  teamId    String
  team      OnCallTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  endsAt    DateTime
  reason    String?
  createdBy String
  createdAt DateTime   @default(now())

  @@index([teamId, startsAt, endsAt])
}

model Device {
  id                       String                 @id @default(uuid())
  name                     String
  hostname                 String
  port                     Int                    @default(22)
  type                     String // mikrotik|linux|huawei_vrp (extensível via plugins)
  manufacturer             String?
  platform                 String?
  model                    String?
  tenantId                 String?
  tenant                   Tenant?              @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  siteId                   String?
  site                     TenantSite?          @relation(fields: [siteId], references: [id], onDelete: SetNull)
  statusServices           StatusService[]
  osVersion                String?
  capabilities             String? // Lista separada por vírgulas: bgp,mpls,isis...
  username                 String
  password                 String // Encrypted (AES-256-GCM)
  group                    String?
  zabbixHostId             String?
  isActive                 Boolean                @default(true)
  notes                    String?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  tasks                    Task[]
  changes                  DeviceChange[]
  backupPolicy             DeviceBackupPolicy?
  configBackups            DeviceConfigBackup[]
  configDrifts             ConfigDrift[]
  vulnerabilityFindings    VulnerabilityFinding[]
  vulnerabilityScans       VulnerabilityScan[]
  compliancePolicy         CompliancePolicy?
  complianceScans          ComplianceScan[]
  complianceExceptions     ComplianceException[]
  complianceScopeId        String?
  complianceScope          ComplianceScopePolicy? @relation("DeviceScopePolicy", fields: [complianceScopeId], references: [id], onDelete: SetNull)
  changeRequestDevices     ChangeRequestDevice[]
  discoveryReferences      DiscoveryHost[]
  capacitySnapshots        CapacitySnapshot[]
  topologyNode             TopologyNode?
  topologyLinksFrom        TopologyLink[]         @relation("TopologyLinkSource")
  topologyLinksTo          TopologyLink[]         @relation("TopologyLinkTarget")
  topologyNeighborsLocal   TopologyNeighbor[]     @relation("TopologyNeighborLocal")
  topologyNeighborsMatched TopologyNeighbor[]     @relation("TopologyNeighborMatched")
  runbookExecutions        RunbookExecution[]
  runbookSchedules         RunbookSchedule[]
  runbookBatchTargets      RunbookBatchTarget[]
  cmdbAsset                 CmdbAsset?
}

model CmdbAsset {
  id             String      @id @default(uuid())
  assetTag       String?     @unique
  name           String
  category       String      @default("network")
  status         String      @default("active")
  criticality    String      @default("medium")
  tenantId       String?
  tenant         Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  siteId         String?
  site           TenantSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)
  deviceId       String?     @unique
  device         Device?     @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  manufacturer   String?
  model          String?
  serialNumber   String?
  hostname       String?
  managementIp   String?
  location       String?
  rack           String?
  rackUnit       String?
  purchaseDate   DateTime?
  warrantyUntil  DateTime?
  supportUntil   DateTime?
  licenseUntil   DateTime?
  cost           Float?
  currency       String      @default("BRL")
  owner          String?
  contact        String?
  tags           String?
  notes          String?
  createdBy      String
  updatedBy      String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  lastInventoryAt DateTime?
  lastInventoryStatus String?
  lastInventoryError String?
  inventoryData  String?
  inventoryPolicy CmdbInventoryPolicy?
  inventorySnapshots CmdbInventorySnapshot[]
  relationshipsFrom CmdbRelationship[] @relation("CmdbRelationshipSource")
  relationshipsTo   CmdbRelationship[] @relation("CmdbRelationshipTarget")
  suggestionsFrom   CmdbRelationshipSuggestion[] @relation("CmdbSuggestionSource")
  suggestionsTo     CmdbRelationshipSuggestion[] @relation("CmdbSuggestionTarget")
  history           CmdbHistory[]
  lifecycleAlerts   CmdbLifecycleAlert[]
  ipAssignments     IpamAddress[]
  businessServices  BusinessServiceAsset[]
  ipamSuggestions   IpamReconciliationSuggestion[]
  commercialContracts CommercialContractAsset[]
  softwareLicenses SoftwareLicenseAsset[]
  interfaces     CmdbInterface[]
  vlans          CmdbVlan[]

  @@index([tenantId, status])
  @@index([siteId, category])
  @@index([category, status])
  @@index([warrantyUntil])
  @@index([supportUntil])
}

model CmdbInterface {
  id          String   @id @default(uuid())
  assetId     String
  asset       CmdbAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  name        String
  description String?
  macAddress  String?
  adminStatus String?
  operStatus  String?
  speed       String?
  vlanId      Int?
  source      String   @default("manual")
  lastSeenAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([assetId, name])
  @@index([vlanId])
  @@index([assetId, operStatus])
}

model CmdbVlan {
  id          String   @id @default(uuid())
  assetId     String
  asset       CmdbAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  vlanId      Int
  name        String?
  status      String   @default("active")
  source      String   @default("manual")
  lastSeenAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([assetId, vlanId])
  @@index([vlanId, status])
}

model IpamSubnet {
  id          String      @id @default(uuid())
  name        String
  cidr        String      @unique
  network     String
  prefix      Int
  gateway     String?
  vlanId      Int?
  tenantId    String?
  tenant      Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  siteId      String?
  site        TenantSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)
  description String?
  createdBy   String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  addresses   IpamAddress[]

  @@index([tenantId, vlanId])
  @@index([siteId, name])
}

model IpamAddress {
  id          String     @id @default(uuid())
  subnetId    String
  subnet      IpamSubnet @relation(fields: [subnetId], references: [id], onDelete: Cascade)
  address     String
  status      String     @default("assigned")
  assetId     String?
  asset       CmdbAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)
  hostname    String?
  description String?
  createdBy   String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([subnetId, address])
  @@index([assetId])
  @@index([address, status])
}

model IpamReconciliationSuggestion {
  id            String    @id @default(uuid())
  originKey     String    @unique
  assetId       String
  asset         CmdbAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  address       String
  cidr          String
  interfaceName String?
  vlanId        Int?
  status        String    @default("suggested")
  evidence      String?
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([assetId, status])
}

model BusinessService {
  id          String    @id @default(uuid())
  name        String
  code        String    @unique
  description String?
  tenantId    String?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  criticality String    @default("medium")
  status      String    @default("active")
  owner       String?
  contact     String?
  slaMinutes  Int?
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  assets      BusinessServiceAsset[]

  @@index([tenantId, status])
  @@index([criticality, status])
}

model BusinessServiceAsset {
  id        String          @id @default(uuid())
  serviceId String
  service   BusinessService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  assetId   String
  asset     CmdbAsset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  role      String          @default("dependency")
  critical  Boolean         @default(false)
  createdAt DateTime        @default(now())

  @@unique([serviceId, assetId])
  @@index([assetId, critical])
}

model CmdbRelationship {
  id            String    @id @default(uuid())
  sourceAssetId String
  sourceAsset   CmdbAsset @relation("CmdbRelationshipSource", fields: [sourceAssetId], references: [id], onDelete: Cascade)
  targetAssetId String
  targetAsset   CmdbAsset @relation("CmdbRelationshipTarget", fields: [targetAssetId], references: [id], onDelete: Cascade)
  type          String
  label         String?
  notes         String?
  critical      Boolean   @default(false)
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([sourceAssetId, targetAssetId, type])
  @@index([sourceAssetId, type])
  @@index([targetAssetId, type])
}

model CmdbRelationshipSuggestion {
  id            String    @id @default(uuid())
  originKey     String    @unique
  sourceAssetId String
  sourceAsset   CmdbAsset @relation("CmdbSuggestionSource", fields: [sourceAssetId], references: [id], onDelete: Cascade)
  targetAssetId String
  targetAsset   CmdbAsset @relation("CmdbSuggestionTarget", fields: [targetAssetId], references: [id], onDelete: Cascade)
  suggestedType String    @default("connected_to")
  evidence      String?
  protocol      String?
  confidence    Int       @default(80)
  status        String    @default("suggested")
  reviewedBy    String?
  reviewedAt    DateTime?
  relationshipId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, confidence])
  @@index([sourceAssetId, targetAssetId])
}

model CmdbHistory {
  id        String    @id @default(uuid())
  assetId   String
  asset     CmdbAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  eventType String
  source    String
  actor     String
  summary   String
  changes   String?
  metadata  String?
  createdAt DateTime  @default(now())

  @@index([assetId, createdAt])
  @@index([eventType, createdAt])
}

model CmdbLifecycleAlert {
  id                String    @id @default(uuid())
  assetId           String
  asset             CmdbAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  type              String
  stage             String
  severity          String
  status            String    @default("active")
  title             String
  message           String
  notificationStage String?
  openedAt          DateTime  @default(now())
  lastSeenAt        DateTime  @default(now())
  resolvedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([assetId, type])
  @@index([status, severity, updatedAt])
}

model LifecycleCatalogEntry {
  id               String   @id @default(uuid())
  vendor           String
  product          String
  lifecycleType    String   @default("software") // software|hardware|license
  productStatus    String   @default("unknown") // active|discontinued|unknown
  modelPattern     String   @default("*")
  versionPattern   String   @default("*")
  releaseDate      DateTime?
  endOfSaleDate    DateTime?
  endOfSupportDate DateTime?
  sourceUrl        String
  sourceTitle      String?
  lastVerifiedAt   DateTime?
  notes            String?
  isActive         Boolean  @default(true)
  createdBy        String
  updatedBy        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([vendor, product, modelPattern, versionPattern])
  @@index([vendor, isActive])
  @@index([endOfSupportDate])
}

model CmdbInventoryPolicy {
  id        String    @id @default(uuid())
  assetId   String    @unique
  asset     CmdbAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  enabled   Boolean   @default(false)
  frequency String    @default("weekly")
  hour      Int       @default(3)
  weekday   Int       @default(1)
  nextRunAt DateTime?
  lastRunAt DateTime?
  lastStatus String?
  lastError String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([enabled, nextRunAt])
}

model CmdbInventorySnapshot {
  id           String    @id @default(uuid())
  assetId      String
  asset        CmdbAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  deviceId     String
  status       String
  manufacturer String?
  model        String?
  serialNumber String?
  hostname     String?
  osVersion    String?
  uptime       String?
  inventoryData String?
  error        String?
  collectedBy  String
  createdAt    DateTime  @default(now())

  @@index([assetId, createdAt])
  @@index([status, createdAt])
}

model Runbook {
  id          String             @id @default(uuid())
  name        String
  description String
  category    String
  deviceType  String             @default("any")
  version     Int                @default(1)
  status      String             @default("draft") // draft|published|archived
  riskLevel   String             @default("low") // low|high|critical
  approvalStatus String          @default("not_required") // not_required|pending|approved|rejected
  approvalRequestedBy String?
  approvalRequestedById String?
  approvalRequestedAt DateTime?
  approvedBy  String?
  approvedById String?
  approvedAt  DateTime?
  rejectionReason String?
  variables   String             @default("[]") // JSON
  steps       String             @default("[]") // JSON
  createdBy   String
  updatedBy   String
  publishedBy String?
  publishedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  executions  RunbookExecution[]
  schedules   RunbookSchedule[]
  batches     RunbookBatch[]
  revisions   RunbookRevision[]

  @@index([status, category])
  @@index([deviceType, status])
}

model RunbookRevision {
  id          String   @id @default(uuid())
  runbookId   String
  runbook     Runbook  @relation(fields: [runbookId], references: [id], onDelete: Cascade)
  version     Int
  name        String
  description String
  category    String
  deviceType  String
  riskLevel   String
  variables   String
  steps       String
  createdBy   String
  createdAt   DateTime @default(now())

