  knowledgeSources String?
  feedback  String? // positive|negative
  deviceId  String? // equipamento fixado quando a mensagem foi gerada
  toolCalls String? // JSON string with tools used
  createdAt DateTime    @default(now())
  attachments ChatAttachment[]
}

model ChatAttachment {
  id              String       @id @default(uuid())
  sessionId       String
  session         ChatSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  messageId       String?
  message         ChatMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  filename        String
  mimeType        String
  size            Int
  content         String
  authorizedForAi Boolean      @default(false)
  includedAt      DateTime?
  createdAt       DateTime     @default(now())

  @@index([sessionId, createdAt])
  @@index([messageId])
}

model AiUsageLog {
  id            String   @id @default(uuid())
  provider      String
  model         String
  agentName     String?
  status        String // success|error|skipped
  errorKind     String? // rate_limit|quota|auth|model|provider|unknown
  errorMessage  String?
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  totalTokens   Int      @default(0)
  estimatedCost Float?
  durationMs    Int?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([provider, createdAt])
  @@index([status, errorKind])
}

model AiProviderState {
  provider          String    @id
  status            String    @default("available") // available|cooldown|quota_exhausted|error
  reason            String?
  cooldownUntil     DateTime?
  consecutiveErrors Int       @default(0)
  lastSuccessAt     DateTime?
  lastErrorAt       DateTime?
  updatedAt         DateTime  @updatedAt
}

model KnowledgeDocument {
  id                String           @id @default(uuid())
  tenantId          String?
  tenant            Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title             String
  filename          String
  sourceType        String           @default("markdown") // markdown|text|pdf|url
  sourceUrl         String?
  collectionRootUrl String?
  content           String
  agentScope        String           @default("global") // global|support|mikrotik|linux|huawei_vrp
  mikrotikRole      String?          // router|switch
  routerOsMajor     String?          // 6|7
  tags              String?
  status            String           @default("active") // active|disabled
  chunkCount        Int              @default(0)
  uploadedBy        String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  chunks            KnowledgeChunk[]

  @@index([agentScope, status])
  @@index([mikrotikRole, routerOsMajor, status])
  @@index([tenantId, status])
  @@index([collectionRootUrl])
  @@index([updatedAt])
}

model KnowledgeChunk {
  id         String            @id @default(uuid())
  documentId String
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  position   Int
  heading    String?
  content    String
  searchText String
  createdAt  DateTime          @default(now())

  @@unique([documentId, position])
  @@index([documentId])
}

model KnowledgeRetrievalLog {
  id          String   @id @default(uuid())
  agentName   String
  query       String
  documentIds String
  chunkIds    String
  resultCount Int
  tenantId    String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([agentName, createdAt])
  @@index([tenantId, createdAt])
}

model KnowledgeImportJob {
  id          String    @id @default(uuid())
  tenantId    String?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  startUrl    String
  urls        String
  agentScope  String
  mikrotikRole String?
  routerOsMajor String?
  tags        String?
  status      String    @default("queued") // queued|running|completed|completed_with_errors|failed
  totalPages  Int
  processed   Int       @default(0)
  imported    Int       @default(0)
  failed      Int       @default(0)
  currentUrl  String?
  errors      String?
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([status, createdAt])
  @@index([tenantId, createdAt])
}

model MonthlyReportRun {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  periodKey   String
  periodFrom  DateTime
  periodTo    DateTime
  status      String   @default("pending") // pending|sent|partial|failed
  reportData  String
  channels    String
  recipients  String?
  deliveryLog String?
  error       String?
  createdAt   DateTime @default(now())
  completedAt DateTime?

  @@unique([tenantId, periodKey])
  @@index([tenantId, createdAt])
  @@index([status, createdAt])
}

model CliSession {
  id           String       @id @default(uuid())
  userId       String
  username     String
  userRole     String
  deviceId     String
  deviceName   String
  deviceType   String
  hostname     String
  mode         String       @default("controlled") // controlled|interactive
  status       String       @default("active") // active|closed|expired
  ipAddress    String?
  userAgent    String?
  startedAt    DateTime     @default(now())
  lastActiveAt DateTime     @default(now())
  endedAt      DateTime?
  commands     CliCommand[]

  @@index([userId, startedAt])
  @@index([deviceId, startedAt])
  @@index([status, lastActiveAt])
}

model CliCommand {
  id            String     @id @default(uuid())
  sessionId     String
  session       CliSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  command       String
  commandType   String // read|change
  justification String?
  status        String     @default("running") // running|success|failure|blocked
  output        String?
  durationMs    Int?
  createdAt     DateTime   @default(now())

  @@index([sessionId, createdAt])
}
