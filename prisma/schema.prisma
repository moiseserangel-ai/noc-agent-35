  totalTargets     Int       @default(0)
  simulatedTargets Int      @default(0)
  succeededTargets Int      @default(0)
  failedTargets    Int       @default(0)
  skippedTargets   Int       @default(0)
  createdBy        String
  approvedBy       String?
  simulatedAt      DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  targets          RunbookBatchTarget[]
