# Server
PORT=3000
HOST=127.0.0.1
NODE_ENV=production
ALLOWED_ORIGINS=http://192.168.250.65

# Database
DATABASE_URL="file:./data/noc-agent.db"

# Security - CHANGE THESE IN PRODUCTION
ENCRYPTION_KEY=<random-64-hex-chars>
JWT_SECRET=<random-secret>
DASHBOARD_PASSWORD=<strong-password>
EVOLUTION_WEBHOOK_TOKEN=<random-webhook-token>

# Claude API
CLAUDE_API_KEY=<your-anthropic-api-key>
CLAUDE_MODEL=claude-sonnet-4-20250514

# OpenAI e Gemini (fallback opcional; também configuráveis pelo painel)
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

# Evolution API
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=<your-evolution-api-key>
EVOLUTION_INSTANCE=noc-agent
ADMIN_WHATSAPP=5511999999999

# Zabbix
ZABBIX_WEBHOOK_TOKEN=<random-token-for-zabbix-webhook>
ZABBIX_URL=http://zabbix.example.com

# Authorized WhatsApp Numbers (comma separated)
AUTHORIZED_NUMBERS=5511999999999,5511888888888

# Catálogo de ciclo de vida: dias até uma fonte oficial exigir nova revisão
LIFECYCLE_CATALOG_REVIEW_DAYS=90
